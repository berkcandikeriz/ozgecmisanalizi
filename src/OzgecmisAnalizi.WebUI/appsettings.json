{
  "Api": {
    "BaseUrl": "https://localhost:7101/",
    "TimeoutSeconds": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "System.Net.Http.HttpClient": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/web-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  },
  "AllowedHosts": "*"
}
