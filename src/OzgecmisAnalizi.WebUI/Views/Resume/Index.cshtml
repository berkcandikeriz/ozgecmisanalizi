@model IReadOnlyList<ResumeListItemDto>
@{ ViewData["Title"] = "CV'lerim"; }
<div class="page-head">
    <div><h1>CV'lerim</h1><p>Her ilan için ayrı bir kopya tutup uyarlamak geri dönüş oranını artırır.</p></div>
    <div class="actions">
        <a class="btn btn-primary" href="/cv/yukle"><svg class="icon"><use href="#i-upload" /></svg>CV yükle</a>
        <form method="post" asp-antiforgery="true" action="/cv/yeni"><button class="btn" type="submit"><svg class="icon"><use href="#i-pen" /></svg>Sıfırdan oluştur</button></form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <h2>Henüz CV yok</h2>
        <p>Mevcut CV'nizi PDF veya Word olarak yükleyin ya da editörde sıfırdan oluşturun.</p>
        <a class="btn btn-primary" href="/cv/yukle">CV yükle</a>
    </div>
}
else
{
    <div class="panel table-wrap">
        <table class="table">
            <thead><tr><th>CV</th><th>Hedef meslek</th><th>Son puan</th><th>Güncellendi</th><th><span class="visually-hidden">İşlemler</span></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <a href="/cv/@r.Id/duzenle"><strong>@r.Title</strong></a>
                            <div class="xs muted">@Fmt.Template(r.Template)@(r.Source == ResumeSource.Upload ? ", yüklenen dosyadan" : "")</div>
                        </td>
                        <td>@(r.TargetProfession ?? "–")</td>
                        <td>
                            @if (r.LastScore is int score)
                            {
                                <a href="/analiz/@r.LastAnalysisId" class="badge badge-@Fmt.Tone(score)">@score / 100</a>
                            }
                            else
                            {
                                <span class="muted small">Analiz edilmedi</span>
                            }
                        </td>
                        <td class="nowrap small muted">@Fmt.Ago(r.UpdatedAt ?? r.CreatedAt)</td>
                        <td>
                            <div class="actions" style="justify-content:flex-end">
                                <form method="post" asp-antiforgery="true" action="/cv/@r.Id/analiz-et"><button class="btn btn-sm btn-primary" type="submit">Analiz et</button></form>
                                <a class="btn btn-sm" href="/cv/@r.Id/pdf"><svg class="icon"><use href="#i-download" /></svg>PDF</a>
                                <a class="btn btn-sm" href="/cv/@r.Id/uyarla">İlana uyarla</a>
                                <form method="post" asp-antiforgery="true" action="/cv/@r.Id/kopyala"><button class="btn btn-sm btn-ghost" type="submit">Kopyala</button></form>
                                <form method="post" asp-antiforgery="true" action="/cv/@r.Id/sil" data-confirm="Bu CV ve analizleri silinsin mi?"><button class="btn btn-sm btn-ghost btn-danger" type="submit">Sil</button></form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
