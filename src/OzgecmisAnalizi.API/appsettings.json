{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=OzgecmisAnaliziDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "OzgecmisAnalizi",
    "Audience": "OzgecmisAnalizi.Clients",
    "Key": "",
    "ExpiryMinutes": 10080
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7201", "http://localhost:5201", "http://localhost:4200", "http://localhost:3000" ]
  },
  "Ai": {
    "Provider": "None",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 60
  },
  "Salary": {
    "MinimumNetWage": 28075.50,
    "ReferenceYear": 2026
  },
  "JobSearch": {
    "DefaultLocation": "Türkiye",
    "Jooble": { "ApiKey": "" },
    "JSearch": { "ApiKey": "", "Country": "tr" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
