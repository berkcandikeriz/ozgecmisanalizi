<?xml version="1.0" encoding="utf-8"?>
<!-- Sunucu genellikle evdeki bilgisayarda düz HTTP (http://192.168.x.x:5201) ile çalışır. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Kullanıcının yüklediği sertifikalar (ör. kendi HTTPS sertifikanız) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
